<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form">
    <f:section title="Pipeline DORA Metrics">

        <div class="jenkins-section__title">Job Filtering</div>
        <f:entry title="Production Job Pattern" field="productionJobPattern"
                 description="Regex to match production jobs (e.g., '.*-prod.*'). Use '.*' for all jobs.">
            <f:textbox default=".*"/>
        </f:entry>
        <f:entry title="Excluded Job Pattern" field="excludedJobPattern"
                 description="Regex for jobs to exclude (e.g., '.*-test.*'). Leave empty to include all.">
            <f:textbox default=""/>
        </f:entry>
        <f:entry title="Production Folders" field="productionFolders"
                 description="Comma-separated folder paths (e.g., 'production,deploy/prod'). Leave empty for pattern matching only.">
            <f:textbox default=""/>
        </f:entry>
        <f:entry title="Production Branch Pattern" field="productionBranchPattern"
                 description="Regex for production branches (e.g., 'main|master|release/.*').">
            <f:textbox default="main|master"/>
        </f:entry>
        <f:entry title="Track All Branches" field="trackAllBranches"
                 description="If unchecked, only production branches count for DORA metrics.">
            <f:checkbox default="true"/>
        </f:entry>
        <f:entry title="Ignore Disabled Pipelines" field="ignoreDisabledPipelines"
                 description="If checked, pipelines that are currently disabled in Jenkins are left out of DORA metrics, rankings and exports, including builds recorded while they were still active. Their history is kept and counts again once they are re-enabled or this is unchecked.">
            <f:checkbox default="false"/>
        </f:entry>

        <div class="jenkins-section__title">General</div>
        <f:entry title="Data Retention (days)" field="retentionDays"
                 description="How many days of metrics to retain locally.">
            <f:number default="365"/>
        </f:entry>
        <f:entry title="Dashboard Top N" field="dashboardTopN"
                 description="Number of pipelines to show in each ranking.">
            <f:number default="10"/>
        </f:entry>

        <f:optionalBlock title="Enable Cloud Storage Export" field="exportEnabled" checked="${instance.exportEnabled}">
            <f:entry title="Export Interval (hours)" field="exportIntervalHours"
                     description="How often to push backup snapshots to cloud storage.">
                <f:number default="24"/>
            </f:entry>
            <f:dropdownDescriptorSelector title="Storage Type" field="exportStorage"
                descriptors="${descriptor.getExportStorageDescriptors()}"/>
        </f:optionalBlock>

        <f:advanced title="DORA Band Thresholds">
            <f:entry title="Deploy Frequency - Elite (deploys/day)" field="dfEliteThreshold">
                <f:number default="1"/>
            </f:entry>
            <f:entry title="Deploy Frequency - High (deploys/day)" field="dfHighThreshold">
                <f:number default="0"/>
            </f:entry>
            <f:entry title="Deploy Frequency - Medium (deploys/day)" field="dfMediumThreshold">
                <f:number default="0"/>
            </f:entry>
            <f:entry title="Lead Time - Elite (seconds)" field="ltEliteSeconds">
                <f:number default="3600"/>
            </f:entry>
            <f:entry title="Lead Time - High (seconds)" field="ltHighSeconds">
                <f:number default="86400"/>
            </f:entry>
            <f:entry title="Lead Time - Medium (seconds)" field="ltMediumSeconds">
                <f:number default="604800"/>
            </f:entry>
            <f:entry title="MTTR - Elite (seconds)" field="mttrEliteSeconds">
                <f:number default="3600"/>
            </f:entry>
            <f:entry title="MTTR - High (seconds)" field="mttrHighSeconds">
                <f:number default="86400"/>
            </f:entry>
            <f:entry title="MTTR - Medium (seconds)" field="mttrMediumSeconds">
                <f:number default="604800"/>
            </f:entry>
            <f:entry title="Change Failure Rate - Elite (%)" field="cfrElitePercent">
                <f:number default="5"/>
            </f:entry>
            <f:entry title="Change Failure Rate - High (%)" field="cfrHighPercent">
                <f:number default="10"/>
            </f:entry>
            <f:entry title="Change Failure Rate - Medium (%)" field="cfrMediumPercent">
                <f:number default="15"/>
            </f:entry>
        </f:advanced>

    </f:section>
</j:jelly>
